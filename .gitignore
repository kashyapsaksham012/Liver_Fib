/main.aux
/main.fls
/main.fdb_latexmk
/main.log
/main_backup_pre_temporal.aux
/main_backup_pre_temporal.fls
/main_backup_pre_temporal.fdb_latexmk
/main_backup_pre_temporal.log
/main_backup_pre_temporal.synctex.gz

# Manual pre-edit backup copies of the manuscript — kept locally as safety
# copies while editing, not tracked in git (git history is the real backup
# for main.tex itself, which stays tracked).
/main_backup_pre_temporal.tex
/main_before_edit.tex.bak
/main_before_review_fixes.tex.bak
/main_before_specfix.tex.bak

